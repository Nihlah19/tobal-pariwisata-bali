{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/kamus", "destination": "/src/pages/kamus.html" },
    { "source": "/budaya", "destination": "/src/pages/budaya.html" },
    { "source": "/budaya/(.*)", "destination": "/src/pages/budaya.html" },
    { "source": "/kenali-budaya", "destination": "/src/pages/kenali-budaya.html" },
    { "source": "/petualangan", "destination": "/src/pages/petualangan.html" },
    { "source": "/lencana", "destination": "/src/pages/lencana.html" },
    { "source": "/masuk", "destination": "/src/pages/masuk.html" },
    { "source": "/onboarding", "destination": "/src/pages/onboarding.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=(self)" }
      ]
    }
  ]
}
