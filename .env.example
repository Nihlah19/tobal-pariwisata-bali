# ==============================================================================
# TOUR PENJELAJAH BALI — ENVIRONMENT VARIABLES
# Salin file ini menjadi .env sebelum menjalankan aplikasi:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. VARIABEL PUBLIK (Frontend / Client-Side)
# ------------------------------------------------------------------------------
# CATATAN: Wajib diawali dengan prefix 'VITE_' agar dapat dibaca oleh Vite di browser.
# Nilai ini akan dimasukkan ke dalam bundle JavaScript publik. Aman untuk anon-key.
#
# URL project Supabase Anda (bisa dilihat di Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public Anon Key (memiliki akses terbatas yang dijaga oleh Row Level Security)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# ------------------------------------------------------------------------------
# 2. VARIABEL RAHASIA (Backend / Serverless Functions / Vercel Environment Variables)
# ------------------------------------------------------------------------------
# PERINGATAN KEAMANAN:
# - JANGAN PERNAH mengawali variabel di bawah ini dengan 'VITE_'
# - JANGAN PERNAH melakukan commit nilai rahasia ini ke Git repository
# - Atur variabel ini di Vercel Dashboard -> Project Settings -> Environment Variables
#
# Supabase Service Role Key (Bypass RLS, HANYA untuk backend Node.js / serverless /api)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Supabase Project URL (Opsional di backend jika serverless membaca VITE_SUPABASE_URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# Google Gemini API Key (Untuk fitur AI Vision pengenalan budaya pada Tahap 9)
GEMINI_API_KEY=your-gemini-ai-studio-api-key

# Nama Model Google Gemini Vision (default rekomendasi: gemini-2.5-flash atau gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash
